# ========================================================
# Weekly Report Platform - 环境变量配置示例
# 复制本文件为 .env.local 并填入实际值即可生效
# ========================================================

# 1. 运行端口（可选，默认 3000）
PORT=3000

# 2. Dify AI 月报智能工作流配置（推荐）
# 如需使用大模型自动提炼月报，请在 Dify 平台导入 dify/monthly_report_workflow.yml，
# 并在此处填入 Dify 服务的 Base URL 与生成的 API Key：
DIFY_API_BASE_URL=http://localhost/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# 提示：若未配置 DIFY_API_KEY，系统会自动启用内置的“本地智能公文规则引擎”作为兜底，月报功能仍可正常使用！

# 3. 管理员系统配置口令（可选，默认口令为 helloworld）
# 点击页面右上角“系统配置”齿轮图标时需要输入此口令，用于添加/排序成员与节假日
NEXT_PUBLIC_ADMIN_PASSWORD=helloworld

# 4. Supabase 云端数据库配置（可选）
# 系统默认采用本地高性能原子单文件持久化（零外部依赖，开箱即用）。
# 若需多节点分布式或云端同步，可填入 Supabase 项目配置：
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
